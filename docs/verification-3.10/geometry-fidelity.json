 "question": "Which stage loses the detail the user reported at 1500: the source dataset, the build-time simplification, or the renderer?",
 "pipeline": [
  {
   "stage": "source",
   "detail": "Cliopatria polys only, fixed commit ad28a691. public/data/native keeps it byte-faithful: simplification=false, coordinateQuantization=false, coordinateRounding=false, repairs=false.",
   "evidence": "public/data/native/manifest.json"
  },
  {
   "stage": "native bootstrap",
   "detail": "data/native/year-<Y>.json.gz is served for -3400, -221, 1, 500, 1000, 1492, 1500, 1750, 1914, 1945, 1991, 2024. At these years the map paints the untouched source geometry.",
   "evidence": "public/native-geometry.js"
  },
  {
   "stage": "display derivative",
   "detail": "public/data/geometries-*.json.gz applies simplify(0.02 deg, preserve_topology) once at build time and rounds to 4 decimals (~11 m).",
   "evidence": "scripts/build_fast_assets.py"
  },
  {
   "stage": "overview snapshot",
   "detail": "public/data/fast/overview-*.json.gz applies a further simplify(0.04 deg). Served first for years without a native bootstrap, then upgraded to the display derivative on moveend.",
   "evidence": "scripts/build_fast_assets.py + public/map-engine.js upgradeDetail"
  },
  {
   "stage": "renderer",
   "detail": "The polities geojson source is created with tolerance:0, so MapLibre adds no extra simplification. Boundary lines are drawn from the same coordinates. \"Border curves\" is a reversible corner-rounding portrayal with a cut of 0.02-4 km that keeps every original vertex as a control point; it re-derives lines from the displayed geometry and never replaces source geometry.",
   "evidence": "public/map-engine.js, public/border-curves.js"
  }
